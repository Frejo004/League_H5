VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# TURN server Metered.ca — obligatoire en production pour les connexions derrière NAT (iPhone 4G, etc.)
# Créer un compte sur https://dashboard.metered.ca → Applications → API Key
# Sans cette clé, le fallback OpenRelay est utilisé (non fiable en prod)
VITE_METERED_API_KEY=your_metered_api_key_here
