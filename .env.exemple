VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# TURN server Metered.ca — obligatoire en production pour les connexions derrière NAT (iPhone 4G, etc.)
# Créer un compte sur https://dashboard.metered.ca → Applications → API Key
# Sans cette clé, le fallback OpenRelay est utilisé (non fiable en prod)
VITE_METERED_API_KEY=your_metered_api_key_here

# Sentry (optionnel) — capture automatique des erreurs runtime en production.
# Créez un projet sur https://sentry.io/ et collez ici le DSN. Sans valeur,
# l'app ne tente aucun envoi et la couche de télémétrie est silencieuse.
VITE_SENTRY_DSN=

# Environnement Sentry (production, staging, …). Défaut : import.meta.env.MODE
VITE_SENTRY_ENV=production

# Version applicative (release) — affichée dans Sentry pour suivre les régressions
VITE_APP_VERSION=0.0.0
